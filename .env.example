# Gmail settings for the server-side contact form.
# Use a Google App Password, not your normal Gmail password.
GMAIL_USER=anchorforgedigital@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password

# The address that receives contact form messages.
CONTACT_TO=anchorforgedigital@gmail.com

# Optional: a verified sender address. Gmail may rewrite this to GMAIL_USER.
MAIL_FROM=anchorforgedigital@gmail.com