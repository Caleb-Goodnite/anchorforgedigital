# SMTP settings for the server-side contact form.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The address that receives contact form messages.
CONTACT_TO=anchorforgedigital@gmail.com

# A verified sender address for your SMTP provider.
MAIL_FROM=website@anchorforgedigital.com